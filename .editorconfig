# EditorConfig: https://editorconfig.org
root = true

# Defaults for all files
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# C# source
[*.cs]
indent_style = space
indent_size = 4
tab_width = 4

# Markup and config files
[*.{json,yml,yaml,xml,csproj,props,targets,slnx}]
indent_style = space
indent_size = 2
tab_width = 2

[*.md]
trim_trailing_whitespace = false

#### C# code style ####
[*.cs]

# var preferences
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion

# Namespaces: file-scoped, usings outside the namespace with System first
csharp_style_namespace_declarations = file_scoped:warning
csharp_using_directive_placement = outside_namespace:warning
dotnet_sort_system_directives_first = true

# File header (short project header; every .cs file should start with it)
file_header_template = EfCoreMcp - MCP server for EF Core model introspection and guarded queries.

#### Naming rules ####

# Types and namespaces: PascalCase
dotnet_naming_symbols.types.applicable_kinds = class, struct, interface, enum, delegate
dotnet_naming_symbols.types.applicable_accessibilities = *
dotnet_naming_rule.types_should_be_pascal_case.symbols = types
dotnet_naming_rule.types_should_be_pascal_case.style = pascal_case_style
dotnet_naming_rule.types_should_be_pascal_case.severity = warning

dotnet_naming_symbols.namespaces.applicable_kinds = namespace
dotnet_naming_symbols.namespaces.applicable_accessibilities = *
dotnet_naming_rule.namespaces_should_be_pascal_case.symbols = namespaces
dotnet_naming_rule.namespaces_should_be_pascal_case.style = pascal_case_style
dotnet_naming_rule.namespaces_should_be_pascal_case.severity = warning

# Interfaces: I-prefixed PascalCase
dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_symbols.interfaces.applicable_accessibilities = *
dotnet_naming_rule.interfaces_should_be_prefixed_with_i.symbols = interfaces
dotnet_naming_rule.interfaces_should_be_prefixed_with_i.style = begins_with_i_style
dotnet_naming_rule.interfaces_should_be_prefixed_with_i.severity = warning

# Public / protected / internal members: PascalCase
dotnet_naming_symbols.public_members.applicable_kinds = property, event, method, field
dotnet_naming_symbols.public_members.applicable_accessibilities = public, protected, internal, protected_internal, private_protected
dotnet_naming_rule.public_members_should_be_pascal_case.symbols = public_members
dotnet_naming_rule.public_members_should_be_pascal_case.style = pascal_case_style
dotnet_naming_rule.public_members_should_be_pascal_case.severity = warning

# Private constants: PascalCase (checked before the private field rule)
dotnet_naming_symbols.private_constants.applicable_kinds = field
dotnet_naming_symbols.private_constants.applicable_accessibilities = private
dotnet_naming_symbols.private_constants.required_modifiers = const
dotnet_naming_rule.private_constants_should_be_pascal_case.symbols = private_constants
dotnet_naming_rule.private_constants_should_be_pascal_case.style = pascal_case_style
dotnet_naming_rule.private_constants_should_be_pascal_case.severity = warning

# Private static readonly fields: PascalCase (standard .NET guidance)
dotnet_naming_symbols.private_static_readonly.applicable_kinds = field
dotnet_naming_symbols.private_static_readonly.applicable_accessibilities = private
dotnet_naming_symbols.private_static_readonly.required_modifiers = static, readonly
dotnet_naming_rule.private_static_readonly_should_be_pascal_case.symbols = private_static_readonly
dotnet_naming_rule.private_static_readonly_should_be_pascal_case.style = pascal_case_style
dotnet_naming_rule.private_static_readonly_should_be_pascal_case.severity = warning

# Private fields: _camelCase
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_rule.private_fields_should_be_underscore_camel_case.symbols = private_fields
dotnet_naming_rule.private_fields_should_be_underscore_camel_case.style = underscore_camel_case_style
dotnet_naming_rule.private_fields_should_be_underscore_camel_case.severity = warning

# Naming styles
dotnet_naming_style.pascal_case_style.capitalization = pascal_case

dotnet_naming_style.begins_with_i_style.required_prefix = I
dotnet_naming_style.begins_with_i_style.capitalization = pascal_case

dotnet_naming_style.underscore_camel_case_style.required_prefix = _
dotnet_naming_style.underscore_camel_case_style.capitalization = camel_case
